generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

model User {
  // --- ACCOUNT & IDENTITY ---
  email             String         @id
  password          String
  role              Role           @default(USER)
  fullName          String
  photoUrl          String?        // Vercel Blob URL
  dob               String?
  address           String?
  
  // --- MEDICAL VITAL DATA ---
  bloodGroup        BloodGroup
  gender            Gender?
  height            String?
  weight            String?
  
  // --- EMERGENCY CONTACT ---
  emergencyName     String
  emergencyPhone    String
  
  // --- MEDICAL DETAILS ---
  medicalConditions String[]       @default([])
  allergies         String[]       @default([])
  medicalNotes      String?        // Medications, notes, and instructions
  
  // --- RELATIONSHIPS ---
  history           MedicalHistory[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model MedicalHistory {
  id          String   @id @default(uuid())
  userEmail   String
  user        User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  
  title       String         
  date        String         
  description String?
  files       Json     @default("[]") // [{ name: string, url: string }]
  
  createdAt   DateTime @default(now())
}
